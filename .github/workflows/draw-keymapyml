name: Draw keymap
on: workflow_dispatch
jobs:
  draw:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install keymap-drawer
      - name: Apply the same options as Build Inputs
        run: printf '#define MIRYOKU_ALPHAS_QWERTY\n' >> miryoku/custom_config.h
      - name: Draw
        run: |
          keymap parse -z config/totem.keymap > totem.yaml
          keymap draw totem.yaml > totem.svg
      - uses: actions/upload-artifact@v4
        with:
          name: keymap-drawing
          path: totem.*
